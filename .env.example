# Telemetria do Next.js desativada (execução 100% local).
NEXT_TELEMETRY_DISABLED=1

# Opcional: fixa "hoje" para testes e demonstrações (ISO 8601 em UTC).
# RELOGIO_FIXO=2026-10-09T12:00:00Z

# Opcional: usa outro arquivo de dados em vez de data/dados.json (o roteiro de aceite usa uma cópia).
# ARQUIVO_DE_DADOS=/caminho/para/dados.json
